+// Optional caps for a public demo: rooms that are still open (created in the last 3 hours and not
+// finished) and rooms created per day. Unset means no limit.
+function roomLimitError() {
+  const maxOpen = Number(process.env.MAX_OPEN_ROOMS) || 0;
+  const maxDaily = Number(process.env.MAX_ROOMS_PER_DAY) || 0;
+  if (maxOpen) {
+    const open = db.prepare("SELECT COUNT(*) AS n FROM quiz_sessions WHERE status != 'FINISHED' AND created_at > datetime('now', '-3 hours')").get().n;
+    if (open >= maxOpen) return "Сейчас открыто слишком много комнат. Попробуйте позже или завершите свою прошлую игру";
+  }
+  if (maxDaily) {
+    const today = db.prepare("SELECT COUNT(*) AS n FROM quiz_sessions WHERE created_at > datetime('now', '-1 day')").get().n;
+    if (today >= maxDaily) return "Лимит комнат на сегодня исчерпан. Демо обновляется раз в сутки";
+  }
+  return "";
+}
